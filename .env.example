# AI provider configuration (DeepSeek MaaS + local Claude Opus CLI)
AI_API_KEY=your_deepseek_or_vertex_key
DEEPSEEK_API_KEY=your_deepseek_or_vertex_key
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash-maas
OPUS_MODEL=claude-opus-4-6-thinking
OPUS_BENCHMARK_ENABLED=true
VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=your_google_cloud_project

# Server Configuration
HOST=0.0.0.0
PORT=7000
WORKSPACE_DIR=./trading_workspace
AGENT_MAX_STEPS=25
COMMAND_TIMEOUT_SECONDS=120

# Paper trading and hard risk limits
TRADING_MODE=paper
INITIAL_CAPITAL_INR=10000.0
AUTO_EXECUTE_DEFAULT=false
MAX_DAILY_LOSS_PCT=1.0
MAX_POSITION_PCT=0.90
MAX_TRADES_PER_DAY=3
MAX_OPEN_POSITIONS=3
RISK_PER_TRADE_PCT=0.75
TARGET_NET_PROFIT_PCT=2.0
MIN_CONFIDENCE=70
PAPER_SLIPPAGE_BPS=5.0
SQUARE_OFF_TIME_IST=15:20

# NSE MIS intraday leverage (1.0 = legacy cash cap; 2.5-5.0 = MIS margin).
INTRADAY_LEVERAGE_MULT=1.0

# Fee-aware entry filters
# Reject a candidate when round-trip fees exceed this % of the rupee risk
# budget (entry-stop)*qty. 100 disables the filter. 18 keeps fees below 18% of 1R.
MAX_FEE_TO_RISK_PCT=18.0
# Require the gross move to target to cover round-trip fees by this multiple.
# 2.2 enforces the 2.2x fee hurdle; 1.0 disables the filter.
MIN_EDGE_TO_FEE_RATIO=2.2

# Market intelligence agent (analysis-only, scored multi-day forecasts).
# It never places a trade: it persists each directional forecast with its
# reference price and horizon, then scores it against the realized close.
MARKET_INTEL_ENABLED=true
MARKET_INTEL_MAX_SYMBOLS=40
MARKET_INTEL_HORIZON_DAYS=5
MARKET_INTEL_FLAT_BAND_PCT=1.0
MARKET_INTEL_MIN_CLOSED_FOR_VERDICT=30
MARKET_INTEL_MAX_AI_CALLS=40
MARKET_INTEL_NEWS_MAX_RESULTS=3
MARKET_INTEL_NOTIONAL_INR=5000.0
MARKET_INTEL_RUN_HOUR_IST=16

# Dashboard Login Authentication
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
SECRET_KEY=change_me_to_a_long_random_value
