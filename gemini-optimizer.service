[Unit]
Description=Gemini Quant Autonomous Strategy Optimizer & Pattern Discovery Daemon
After=network.target gemini-agent.service
Wants=gemini-agent.service

[Service]
Type=simple
User=crimson
WorkingDirectory=/home/crimson/GeminiAgent
Environment="PATH=/home/crimson/GeminiAgent/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/crimson/GeminiAgent"
ExecStart=/home/crimson/GeminiAgent/venv/bin/python3 -u app/trading/continuous_optimizer.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gemini-optimizer

# Resource Limits: Capped well within 16 GB RAM boundary
MemoryMax=3G
MemoryHigh=2.5G
CPUQuota=150%

[Install]
WantedBy=multi-user.target

